  "slides": [
    {
      "id": "slide-title",
      "type": "title",
      "title": "Webサーバーと Flask のしくみ",
      "subtitle": "ページが表示されるまでと、Flask の役割"
    },
    {
      "id": "slide-reqres",
      "type": "custom",
      "component": "RunFlow",
      "props": {
        "title": "リクエストとレスポンス（決まり事は HTTP）",
        "lanes": [
          {
            "label": "頼む",
            "steps": [
              {
                "name": "ブラウザ",
                "sub": "クライアント"
              },
              {
                "name": "リクエスト",
                "sub": "このページをください"
              },
              {
                "name": "Webサーバー"
              }
            ]
          },
          {
            "label": "返す",
            "steps": [
              {
                "name": "Webサーバー"
              },
              {
                "name": "レスポンス",
                "sub": "ページの中身（HTML）"
              },
              {
                "name": "ブラウザ",
                "sub": "画面に表示"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "slide-static-dynamic",
      "type": "bullets",
      "items": [
        "置いてあるファイルを、そのまま返す",
        "プログラムが、その場でページを作って返す",
        "Flask は、後のほうを Python で書くための道具"
      ],
      "title": "サーバーの返し方は 2 通り"
    },
    {
      "id": "slide-url",
      "type": "code",
      "code": "http://127.0.0.1:5000/\n\nhttp://     … 決まり事（HTTP）\n127.0.0.1   … どのコンピュータか（自分自身。localhost）\n:5000       … ポート番号（コンピュータの中の窓口）\n/           … パス（どのページか）\n",
      "title": "URL の読み方"
    },
    {
      "id": "slide-flask-code",
      "type": "code",
      "code": "from flask import Flask\n\napp = Flask(__name__)\n\n@app.route(\"/\")\ndef hello_world():\n    return \"<p>Hello, World!</p>\"\n",
      "title": "いちばん小さい Flask のアプリ（hello.py）"
    },
    {
      "id": "slide-flask-flow",
      "type": "custom",
      "component": "RunFlow",
      "props": {
        "title": "Flask がしてくれること",
        "lanes": [
          {
            "steps": [
              {
                "name": "リクエスト",
                "sub": "「/」をください"
              },
              {
                "name": "@app.route(\"/\")",
                "sub": "呼ぶ関数を探す"
              },
              {
                "name": "hello_world()",
                "sub": "関数を呼ぶ"
              },
              {
                "name": "レスポンス",
                "sub": "返り値を送る"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "slide-run",
      "type": "code",
      "code": "> flask --app hello run\n * Serving Flask app 'hello'\n * Debug mode: off\nWARNING: This is a development server. Do not use it\n  in a production deployment. Use a production WSGI\n  server instead.\n * Running on http://127.0.0.1:5000\nPress CTRL+C to quit\n127.0.0.1 - - [...] \"GET / HTTP/1.1\" 200 -\n127.0.0.1 - - [...] \"GET /nothing HTTP/1.1\" 404 -\n",
      "title": "動かす（Flask 2.3.2）"
    },
    {
      "id": "slide-venv",
      "type": "custom",
      "component": "RunFlow",
      "props": {
        "title": "仮想環境 ＝ プロジェクトごとの部品の置き場",
        "lanes": [
          {
            "label": "授業用",
            "steps": [
              {
                "name": "Python 3.10"
              },
              {
                "name": "Flask 2.3.2"
              }
            ]
          },
          {
            "label": "別の作品",
            "steps": [
              {
                "name": "Python 3.12"
              },
              {
                "name": "Flask 3.1.3"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "slide-venv-good",
      "type": "bullets",
      "items": [
        "部品の版がぶつからない",
        "Python 本体を汚さない",
        "同じ組み合わせを、別のパソコンでも作り直せる"
      ],
      "title": "よいところ"
    },
    {
      "id": "slide-venv-bad",
      "type": "bullets",
      "items": [
        "使う前に毎回、切り替えが要る（忘れると「部品が無い」）",
        "置き場ごとに部品を入れ直す手間",
        "conda と pip を混ぜると、組み合わせが崩れることがある"
      ],
      "title": "困るところ"
    },
    {
